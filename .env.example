# =============================================================================
# Copiez ce fichier vers ".env" à la racine (même dossier que docker-compose.yml).
#   Windows :  copy .env.example .env
#   bash :     cp .env.example .env
# Docker Compose charge automatiquement ".env" pour les substitutions et l’environnement.
# =============================================================================

# Build Compose (évite sur certaines installations : failed to execute bake...)
COMPOSE_BAKE=false

# --- Optionnel : nom du projet Docker (isole les conteneurs sur une machine partagée)
# COMPOSE_PROJECT_NAME=projet-de-transport

# --- Optionnel plus tard : variables pour docker-compose avec ${VAR}
# (décommentez quand le compose utilise ${POSTGRES_PASSWORD}, etc.)
# POSTGRES_USER=transport
# POSTGRES_PASSWORD=changez-moi
# POSTGRES_DB=transport_db
