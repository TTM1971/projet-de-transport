# =============================================================================
# Backend FastAPI — copiez vers "backend/.env" pour un run local HORS Docker
# (uvicorn depuis le dossier backend). En Docker, les variables viennent du compose.
# =============================================================================

# --- PostgreSQL (option A : variables séparées)
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=password
DB_NAME=transport_db
DB_PORT=5432

# Option B — URL unique (remplace l’option A si défini ; pilote psycopg dans database.py)
# DATABASE_URL=postgresql://user:password@localhost:5432/transport_db

# SSL vers PostgreSQL managé : disable | require | verify-full
# PGSSLMODE=disable

# --- CORS / sécurité HTTP
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
SECURITY_STRICT_ORIGIN=false
SECURITY_ALLOW_MISSING_ORIGIN=true

# Hôtes autorisés (Host header), séparés par des virgules — ex. api.mondomaine.com
TRUSTED_HOSTS=

# --- Divers
# DRIVER_TRIP_BLOCK_MINUTES=90

# Note JWT : la clé par défaut est dans auth/jwt_handler.py ; en production, prévoir
# une variable d’environnement et charger SECRET_KEY depuis le secret manager.
