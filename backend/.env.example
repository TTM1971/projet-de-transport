# --- Base PostgreSQL (dev Docker : variables dans docker-compose.yml) ---
# Option A — variables séparées (identique au docker-compose)
# DB_HOST=db.example.com
# DB_USER=transport
# DB_PASSWORD=secret
# DB_NAME=transport_db
# DB_PORT=5432

# Option B — URL unique (hébergeurs cloud, remplace l’option A si défini)
# DATABASE_URL=postgresql://user:password@host:5432/transport_db

# Connexion SSL vers PostgreSQL managé (ex. require, verify-full, disable en local pur)
# PGSSLMODE=require

# --- Sécurité HTTP / CORS ---
# Origines autorisées (CORS + contrôle Origin si SECURITY_STRICT_ORIGIN=true)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# true en production : POST/PUT/PATCH/DELETE refusés si Origin absent ou non listé (navigateur)
SECURITY_STRICT_ORIGIN=false

# Si STRICT_ORIGIN=true : autoriser les clients sans en-tête Origin (curl, scripts internes)
SECURITY_ALLOW_MISSING_ORIGIN=true

# Hôtes HTTP autorisés (ex: api.mondomaine.com,localhost) — laisser vide en dev local
TRUSTED_HOSTS=
