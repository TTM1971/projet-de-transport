# Origines autorisées (CORS + contrôle Origin si SECURITY_STRICT_ORIGIN=true)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# true en production : POST/PUT/PATCH/DELETE refusés si Origin absent ou non listé (navigateur)
SECURITY_STRICT_ORIGIN=false

# Si STRICT_ORIGIN=true : autoriser les clients sans en-tête Origin (curl, scripts internes)
SECURITY_ALLOW_MISSING_ORIGIN=true

# Hôtes HTTP autorisés (ex: api.mondomaine.com,localhost) — laisser vide en dev local
TRUSTED_HOSTS=
