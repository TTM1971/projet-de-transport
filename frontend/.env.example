# =============================================================================
# Frontend React (Create React App)
# =============================================================================
# Développement local avec "npm start" (sans conteneur frontend) :
#   copiez ce fichier vers ".env" ou ".env.development.local"
#
# Avec "docker compose", le frontend reçoit les variables du docker-compose.yml ;
# le fichier frontend/.env monté sert surtout au npm start local.
# =============================================================================

# Toujours un chemin relatif (même origine que :3000 ou :80) — jamais http://backend:8000
REACT_APP_API_URL=/api

# Cible du proxy webpack (setupProxy.js) — machine hôte quand npm run sur le PC
PROXY_BACKEND=http://127.0.0.1:8000

# Détail : voir aussi .env.development.example
