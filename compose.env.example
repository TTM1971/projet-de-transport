# Copiez ce fichier vers ".env" à la racine du projet (même dossier que docker-compose.yml) :
#   copy compose.env.example .env
# Docker Compose charge automatiquement ".env" pour l'environnement du projet.
#
# Désactive le chemin de build "bake" (évite l'erreur :
#   failed to execute bake: read |0: file already closed
# sur certaines versions de Docker Desktop / Compose).
COMPOSE_BAKE=false
